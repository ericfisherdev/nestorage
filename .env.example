# Nestorage configuration — copy to .env for local development (.env is
# gitignored). Real environment variables always override values in .env;
# .env is only read when APP_ENV is dev (or unset, since dev is the
# default). Every variable below is read by internal/platform/config, via
# nestcore's config package.

# Deployment environment: dev | test | prod
APP_ENV=dev

# HTTP listen port (a leading colon is tolerated, e.g. ":8080").
PORT=8080

# Postgres connection string. Required in every environment, including dev —
# copy this file to .env (gitignored) and fill in your local compose
# credentials; `docker compose up -d` starts a matching Postgres on
# 127.0.0.1:5433 using compose.yaml's own nestorage/nestorage service
# credentials, which is what the placeholder below points at.
DATABASE_URL=postgres://nestorage:nestorage@localhost:5433/nestorage?sslmode=disable

# --- Database pool tuning (optional) -----------------------------------------
# DB_MAX_CONNS=10
# DB_CONNECT_TIMEOUT=5s

# Bounds how long a single request may take end to end (connection-level
# ReadTimeout/WriteTimeout, and — minus a small margin — the per-request
# context deadline every handler runs under). Minimum 15s.
# SERVER_REQUEST_TIMEOUT=2m

# Optional app-terminated TLS. Set BOTH to have the server listen with TLS
# itself (ListenAndServeTLS); leave both unset to serve plain HTTP behind a
# reverse proxy (the default — see "Deployment" in CLAUDE.md for the
# tailscale serve shape this appliance runs behind).
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# --- Sessions -----------------------------------------------------------------
# High-entropy signing/encryption key for server-side sessions, at least 32
# bytes. The default below is fine in dev but is rejected outright in prod.
# Generate a real one with: openssl rand -hex 32
SESSION_SECRET=dev-only-insecure-session-secret-change-me
# Absolute session lifetime (Go duration). Idle sessions expire at half this.
SESSION_LIFETIME=12h
# auto (default) sets the cookie Secure flag only in prod; true/false force it
# regardless of APP_ENV — useful when a TLS-terminating proxy fronts a
# non-prod deployment.
# SESSION_COOKIE_SECURE=auto

# --- Reverse-proxy / HTTPS (optional) ----------------------------------------
# When running behind a TLS-terminating reverse proxy (tailscale serve),
# Nestorage stays HTTP and derives the scheme from X-Forwarded-Proto, trusted
# only from TRUSTED_PROXIES.
#
# CIDRs whose X-Forwarded-* headers are trusted. Defaults to loopback (a
# same-host proxy); widen only if the proxy connects from another address.
# Empty trusts none.
# TRUSTED_PROXIES=127.0.0.0/8,::1/128
# Strict-Transport-Security (only sent over HTTPS). Enable on a stable
# HTTPS host.
# HSTS_ENABLED=true
# HSTS_MAX_AGE=4320h   # 180 days (Go duration; d/days is not valid)
# HSTS_INCLUDE_SUBDOMAINS=false
# HSTS_PRELOAD=false
# -----------------------------------------------------------------------------

# --- Photo storage (NSTR-34) --------------------------------------------------
# MEDIA_ROOT is where the local PhotoStore writes photo bytes; it has a safe
# default in every environment, so a fresh install needs zero configuration.
# MEDIA_MAX_UPLOAD_BYTES caps a single photo upload (bytes).
# MEDIA_ROOT=./media
# MEDIA_MAX_UPLOAD_BYTES=10485760
# -----------------------------------------------------------------------------

# --- Photo storage backend (NSTR-35) ------------------------------------------
# Which domain.PhotoStore implementation photo uploads go through: local (the
# default, MEDIA_ROOT above) or s3 (an S3-compatible object store — AWS S3, or
# a self-hosted MinIO/Garage endpoint on the LAN). Switching backends does not
# retroactively move already-stored bytes.
# MEDIA_STORAGE_BACKEND=local

# The S3 knobs below are only required when MEDIA_STORAGE_BACKEND=s3 — a
# local-only install can leave every one of them unset.
#
# Custom endpoint for a self-hosted S3-compatible server. `docker compose up
# -d minio` starts one matching this placeholder, at 127.0.0.1:59001. Leave
# unset to target real AWS S3.
# S3_ENDPOINT=http://127.0.0.1:59001
# Required when the S3 backend is selected. Most self-hosted servers accept
# any non-empty value (they do not partition by region).
# S3_REGION=us-east-1
# Required when the S3 backend is selected: the single bucket every photo is
# stored under (created ahead of time — NewS3PhotoStore verifies it exists at
# startup rather than creating it).
# S3_BUCKET=nestorage-photos
# Optional static credentials, matching compose.yaml's minio service (dev
# only — NOT for production). When both are left unset, the AWS SDK's default
# credential chain (environment, shared config file, instance role, etc.)
# supplies credentials instead.
# S3_ACCESS_KEY_ID=nestorage
# S3_SECRET_ACCESS_KEY=nestorage-dev-minio
# Path-style bucket addressing (https://endpoint/bucket/key). Required by
# MinIO and most self-hosted S3-compatible servers; leave false for AWS S3.
# S3_USE_PATH_STYLE=true
# How long a presigned GET URL stays valid. Go duration syntax; default 15m.
# S3_PRESIGN_TTL=15m
# -----------------------------------------------------------------------------
