package components

import "strconv"

// ItemRowView is the read-only projection of an item BinDetail's contents
// list renders — a name and quantity only; item CRUD is a later ticket's
// work (NSTR-31 only reads a bin's contents, per the sprint-level
// decision).
type ItemRowView struct {
	Name        string
	Description string
	Quantity    int
	// PhotoURL is the item's primary photo thumbnail URL (NSTR-37),
	// pre-built by adapter.buildItemRows from a single fan-in
	// primaryPhotoRefLister call — empty means no primary photo, and
	// binItemsList renders the neutral placeholder block instead.
	PhotoURL string
}

// BinDetailView is the view-layer model for a bin's detail page: its own
// header (name, code, owner, location, private marker), the move-bin
// control, and its read-only contents list.
type BinDetailView struct {
	CSRFToken    string
	ID           string
	Code         string
	Name         string
	Description  string
	LocationName string
	Owner        OwnerView
	Private      bool
	Items        []ItemRowView
	// FormError shows the mapped error from a rejected delete (e.g. the
	// bin still holds an item). Empty means no error is shown.
	FormError string
	// QRDataURI is the "data:image/png;base64,..." deep-link QR
	// (NSTR-48), pre-rendered server-side by
	// BinsWebHandlers.renderDetailView. Empty means render the detail page
	// without it — either the QR render failed (a non-critical
	// enhancement, not a page failure) and was logged there, or a future
	// caller of this view type simply has none to offer.
	QRDataURI string
	// DeepLinkURL is the absolute URL QRDataURI encodes (app.BinDeepLinkURL's
	// own output), shown as a plain-text fallback beneath the QR so the
	// page still works when a scan fails or a printed label is unavailable.
	DeepLinkURL string
}

// binDetailID is the DOM id the edit/delete/move controls target for their
// HTMX outerHTML swap.
const binDetailID = "bin-detail"

// BinDetail renders one bin's header, its move control, and its contents.
templ BinDetail(view BinDetailView, move MoveBinView) {
	<div id={ binDetailID } class="flex flex-col gap-4">
		<div class="flex flex-wrap items-start justify-between gap-3 border-b border-border px-[26px] pb-4 pt-5">
			<div class="flex items-start gap-3">
				@OwnerAvatar(view.Owner)
				<div>
					<h2 class="flex items-center gap-1.5 text-xl font-extrabold text-text">
						{ view.Name }
						if view.Private {
							<span class="text-text-faint">
								@IconLock("h-[15px] w-[15px]")
								<span class="sr-only">Private</span>
							</span>
						}
					</h2>
					<p class="mt-1 flex items-center gap-1 text-sm text-text-faint">
						@IconPin("h-[14px] w-[14px]")
						{ view.LocationName }
					</p>
					<div class="mt-1">
						@BinCode(view.Code)
					</div>
				</div>
			</div>
			<div class="flex items-center gap-2">
				<a
					href={ templ.SafeURL("/labels/print?bin=" + view.ID) }
					class="flex min-h-[44px] items-center gap-1.5 rounded-button border border-border-input px-3 py-2 text-sm font-semibold text-text-secondary hover:bg-surface-raised"
				>
					@IconPrinter("h-4 w-4")
					<span class="sr-only">Print </span>Print label
				</a>
				<a
					href={ templ.SafeURL("/b/" + view.Code + "/edit") }
					class="flex min-h-[44px] items-center gap-1.5 rounded-button border border-border-input px-3 py-2 text-sm font-semibold text-text-secondary hover:bg-surface-raised"
				>
					@IconPencil("h-4 w-4")
					<span class="sr-only">Edit </span>Edit
				</a>
				@deleteBinForm(view)
			</div>
			@binQRBlock(view)
		</div>
		if view.FormError != "" {
			<p role="alert" class="mx-[26px] rounded-input border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-600">{ view.FormError }</p>
		}
		@MoveBinForm(move)
		@binItemsList(view.Items)
		@BinActivityStub(view.Code)
	</div>
}

// deleteBinForm renders the bin detail's delete control. A successful
// delete has nowhere left to swap back into (the bin is gone) —
// BinsWebHandlers answers with an HX-Redirect to /bins instead, matching
// LocationDetail's own deleteLocationForm doc for the same exception;
// hx-target/hx-swap below only govern the rejected (still-has-items) case.
templ deleteBinForm(view BinDetailView) {
	<form
		method="POST"
		action={ templ.SafeURL("/bins/" + view.ID + "/delete") }
		hx-post={ "/bins/" + view.ID + "/delete" }
		hx-target={ "#" + binDetailID }
		hx-swap="outerHTML"
		hx-confirm="Delete this bin?"
	>
		<input type="hidden" name="csrf_token" value={ view.CSRFToken }/>
		<button type="submit" class="flex min-h-[44px] items-center gap-1.5 rounded-button border border-border-input px-3 py-2 text-sm font-semibold text-text-secondary hover:bg-surface-raised">
			@IconTrash("h-4 w-4")
			<span class="sr-only">Delete </span>Delete
		</button>
	</form>
}

// binQRBlock renders the bin detail page's deep-link QR (NSTR-48) as an
// aside beside the header: a scannable code, its bin-code caption in Space
// Mono (BinCode, matching the header's own), and the underlying URL as
// plain text so the page still works when a scan fails or the label is
// unavailable. Renders nothing when QRDataURI is empty — a QR render
// failure degrades the page rather than failing it (see
// BinsWebHandlers.renderDetailView's own doc), and NSTR-31's pre-NSTR-48
// callers of this view type simply leave it unset. White background and
// padding hold scan contrast regardless of the surrounding theme.
templ binQRBlock(view BinDetailView) {
	if view.QRDataURI != "" {
		<div class="flex flex-col items-center gap-1" data-testid="bin-detail-qr">
			<img
				src={ view.QRDataURI }
				alt={ "QR code linking to bin " + view.Code }
				width="96"
				height="96"
				class="h-24 w-24 rounded-input border border-border bg-white p-2"
			/>
			@BinCode(view.Code)
			<span class="max-w-[140px] truncate text-[11px] text-text-faint" title={ view.DeepLinkURL }>
				{ view.DeepLinkURL }
			</span>
		</div>
	}
}

// binItemsList renders the bin's contents as a read-only row per item, or
// an empty-state message. Each row carries its primary-photo thumbnail (or
// a neutral placeholder, NSTR-37) — never a full-resolution image.
templ binItemsList(items []ItemRowView) {
	<div class="px-[26px] pb-6">
		<h3 class="mb-3 text-sm font-bold text-text-secondary">Contents</h3>
		<ul class="flex flex-col gap-2">
			if len(items) == 0 {
				<li class="text-sm text-text-faint">This bin is empty.</li>
			}
			for _, it := range items {
				<li class="flex items-center justify-between rounded-card border border-border px-3 py-2 text-sm">
					<span class="flex items-center gap-3">
						@itemRowThumbnail(it)
						<span class="font-semibold text-text">{ it.Name }</span>
					</span>
					<span class="text-text-faint">×{ strconv.Itoa(it.Quantity) }</span>
				</li>
			}
		</ul>
	</div>
}

// itemRowThumbnail renders a bin contents row's primary-photo thumbnail
// (NSTR-37), or a neutral placeholder block when PhotoURL is empty —
// mirrors item_search.templ's own resultThumbnail exactly (a separate copy,
// since the two view types are unrelated structs).
templ itemRowThumbnail(it ItemRowView) {
	if it.PhotoURL != "" {
		<img src={ it.PhotoURL } alt="" class="h-8 w-8 flex-none rounded-input object-cover"/>
	} else {
		<span class="flex h-8 w-8 flex-none items-center justify-center rounded-input bg-surface text-text-faint">
			@IconImage("h-4 w-4")
		</span>
	}
}
