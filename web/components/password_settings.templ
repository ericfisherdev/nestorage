package components

// PasswordSettingsView is the view-layer model for the self-service
// password-change screen (NSTR-103) — not a domain type, matching the
// rationale already written on DeviceView/EventSection (this package's
// other domain-adjacent view models).
type PasswordSettingsView struct {
	// CSRFToken is the per-session CSRF token embedded as a hidden form
	// field. Ignored when Federated is true.
	CSRFToken string
	// Error is a validation or credential-check message shown below the
	// form. Empty means no error is shown. Ignored when Federated is true.
	Error string
	// Success is the confirmation shown after a successful change. Empty
	// means no confirmation is shown. Ignored when Federated is true.
	Success string
	// Federated replaces the form entirely with a notice linking to the
	// identity provider (NSTR-100): a federated household owns none of its
	// members' passwords, so the form itself would be misleading — the
	// same rationale components.LoginForm.Federated already documents.
	Federated bool
	// ProviderURL is the identity provider's origin the federated notice
	// links to. Ignored when Federated is false.
	ProviderURL string
}

// passwordSettingsID is the DOM id the form's HTMX outerHTML swap targets,
// so a change re-renders the whole screen from one response — the same
// pattern deviceListID/notificationSettingsID use.
const passwordSettingsID = "password-settings"

// PasswordSettings renders the self-service password-change screen: the
// three-field form in standalone mode, or a fixed notice linking to the
// identity provider in federated mode — mirrors components.LoginPage's own
// Federated branch.
templ PasswordSettings(view PasswordSettingsView) {
	<div id={ passwordSettingsID } class="flex flex-col gap-6 p-[26px]">
		<div>
			<h2 class="text-xl font-extrabold text-text">Password</h2>
			<p class="mt-1 text-[15px] text-text-faint">Change the password you sign in with.</p>
		</div>
		if view.Federated {
			<p role="alert" class="text-sm text-text-secondary">
				Password changes are managed by your household's identity provider —
				visit <a href={ templ.SafeURL(view.ProviderURL) } class="font-semibold text-primary underline">its account settings</a> to change your password.
			</p>
		} else {
			<form
				method="POST"
				action="/settings/password"
				hx-post="/settings/password"
				hx-target={ "#" + passwordSettingsID }
				hx-swap="outerHTML"
			>
				<input type="hidden" name="csrf_token" value={ view.CSRFToken }/>
				<div class="flex flex-col gap-4">
					<div class="flex flex-col gap-1">
						<label for="current_password" class="text-sm font-semibold text-text-secondary">Current password</label>
						<input
							id="current_password"
							type="password"
							name="current_password"
							autocomplete="current-password"
							required
							class="rounded-input border border-border-input bg-surface px-3 py-2 text-base text-text placeholder:text-text-faint focus:border-primary focus:outline-none"
						/>
					</div>
					<div class="flex flex-col gap-1">
						<label for="new_password" class="text-sm font-semibold text-text-secondary">New password</label>
						<input
							id="new_password"
							type="password"
							name="new_password"
							autocomplete="new-password"
							required
							class="rounded-input border border-border-input bg-surface px-3 py-2 text-base text-text placeholder:text-text-faint focus:border-primary focus:outline-none"
						/>
					</div>
					<div class="flex flex-col gap-1">
						<label for="new_password_confirmation" class="text-sm font-semibold text-text-secondary">Confirm new password</label>
						<input
							id="new_password_confirmation"
							type="password"
							name="new_password_confirmation"
							autocomplete="new-password"
							required
							class="rounded-input border border-border-input bg-surface px-3 py-2 text-base text-text placeholder:text-text-faint focus:border-primary focus:outline-none"
						/>
					</div>
					if view.Error != "" {
						<p role="alert" class="text-sm text-red-600">{ view.Error }</p>
					}
					if view.Success != "" {
						<p role="status" class="text-sm text-green-700">{ view.Success }</p>
					}
					<button
						type="submit"
						class="self-start rounded-button bg-primary px-4 py-[13px] text-md font-semibold text-white shadow-primary hover:bg-primary-deep"
					>
						Change password
					</button>
				</div>
			</form>
		}
	</div>
}
