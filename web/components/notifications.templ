package components

import "strconv"

// NotificationBadgeView is the sidebar bell's own view model.
type NotificationBadgeView struct {
	UnreadCount int
}

// NotificationItemView is one row in the /notifications inbox list.
type NotificationItemView struct {
	ID    string
	Title string
	Body  string
	// Time is pre-formatted by the web adapter (formatNotificationTime's
	// own "no time.Time reaches this layer" contract, mirroring
	// formatStoredDate/formatHistoryTime elsewhere in this codebase).
	Time string
	// Unread selects whether this row renders its own mark-read control.
	Unread    bool
	CSRFToken string
}

// NotificationInboxView is the /notifications page's own view model:
// every notification for the signed-in viewer, newest first.
type NotificationInboxView struct {
	Items []NotificationItemView
}

// notificationsBadgeID is the DOM id NotificationBellStub's own hx-get
// swaps into — this section's own fragment boundary, disjoint from
// itemDetailID/itemLinksID/itemPhotosID/itemHistoryID (none of which live
// in the sidebar) — see NSTR-44's own reconciliation for why it collides
// with nothing already merged.
const notificationsBadgeID = "notifications-badge"

// notificationsInboxID is the DOM id NotificationInbox's own outer div
// carries — MarkRead's own hx-target/outerHTML swap boundary.
const notificationsInboxID = "notifications-inbox"

// NotificationBellStub is layout.templ's own single include line for the
// sidebar bell: a self-contained, initially-empty div that hx-gets its
// real content from InboxWebHandlers.Badge — the identical
// stub-then-server-render arrangement item_detail.templ's own
// ItemHistoryStub/PhotoGalleryStub use (Sprint 5/6 reconciliation),
// disturbing neither. Refetches on every page load and again whenever a
// POST /notifications/{id}/read fires the notifications-updated event
// (see markReadForm's own hx-post), so the count shrinks without a full
// page reload.
templ NotificationBellStub() {
	<div id={ notificationsBadgeID } hx-get="/notifications/badge" hx-trigger="load, notifications-updated from:body" hx-swap="outerHTML"></div>
}

// NotificationBadge renders the sidebar bell plus its unread count —
// InboxWebHandlers.Badge's own response, and NotificationBellStub's own
// hx-get target. The numeral only renders when UnreadCount is positive, so
// a fully-read inbox shows a bare bell.
templ NotificationBadge(view NotificationBadgeView) {
	<div id={ notificationsBadgeID }>
		<a
			href="/notifications"
			class="relative flex items-center justify-center rounded-nav p-2 text-text-secondary hover:bg-sidebar-accent"
			aria-label={ notificationBellLabel(view.UnreadCount) }
		>
			@IconBell("h-[21px] w-[21px]")
			if view.UnreadCount > 0 {
				<span class="absolute -right-1 -top-1 flex h-4 min-w-[16px] items-center justify-center rounded-full bg-primary px-1 text-[10px] font-bold text-white">
					{ strconv.Itoa(view.UnreadCount) }
				</span>
			}
		</a>
	</div>
}

// notificationBellLabel names the bell's accessible label, carrying the
// unread count so a screen-reader user gets it without the visual badge.
func notificationBellLabel(unread int) string {
	if unread == 0 {
		return "Notifications, no unread"
	}
	return "Notifications, " + strconv.Itoa(unread) + " unread"
}

// NotificationInbox renders the /notifications page's own list. Rendered
// by InboxWebHandlers.Inbox for both the bare-fragment (hx-request) and
// full-page cases, and by MarkRead's own outerHTML swap, so this div's own
// id/shape must stay identical across all three.
templ NotificationInbox(view NotificationInboxView) {
	<div id={ notificationsInboxID } class="flex flex-col gap-3 p-[26px]">
		<h2 class="text-xl font-extrabold text-text">Notifications</h2>
		if len(view.Items) == 0 {
			<p class="text-sm text-text-faint">No notifications yet.</p>
		} else {
			<ul class="flex flex-col gap-2">
				for _, item := range view.Items {
					@notificationRow(item)
				}
			</ul>
		}
	</div>
}

// notificationRow renders one notification, its own mark-read control only
// when still unread.
templ notificationRow(item NotificationItemView) {
	<li class={ "flex items-start justify-between gap-3 rounded-input border border-border p-3", notificationRowClass(item.Unread) }>
		<div class="flex flex-col gap-1">
			<p class="text-sm font-semibold text-text">{ item.Title }</p>
			<p class="text-sm text-text-secondary">{ item.Body }</p>
			<p class="text-xs text-text-faint">{ item.Time }</p>
		</div>
		if item.Unread {
			@markReadForm(item)
		}
	</li>
}

// notificationRowClass tints an unread row so it stands out from an
// already-read one.
func notificationRowClass(unread bool) string {
	if unread {
		return "bg-sidebar-accent"
	}
	return "bg-surface"
}

// markReadForm renders one notification row's mark-read control, HTMX-posted
// to InboxWebHandlers.MarkRead and swapped into the whole inbox fragment's
// own outerHTML — mirrors returnForm/checkOutForm's identical
// "re-render the whole fragment" convention.
templ markReadForm(item NotificationItemView) {
	<form
		method="POST"
		action={ templ.SafeURL("/notifications/" + item.ID + "/read") }
		hx-post={ "/notifications/" + item.ID + "/read" }
		hx-target={ "#" + notificationsInboxID }
		hx-swap="outerHTML"
	>
		<input type="hidden" name="csrf_token" value={ item.CSRFToken }/>
		<button type="submit" class="whitespace-nowrap text-xs font-semibold text-primary-deep hover:underline">
			Mark read
		</button>
	</form>
}
